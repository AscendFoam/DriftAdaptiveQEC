\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Metric-level advantage summary. The strongest current evidence is logical-error reduction in software-HIL, with `statcalib' retained only as a separately labeled extension-lane supplement. Latency, resource, and cost advantages are architecture-level consequences of the affine fast path and should be measured on hardware before being written as deployment results.}}{22}{table.caption.8}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:metric-advantages}{{1}{22}{Metric-level advantage summary. The strongest current evidence is logical-error reduction in software-HIL, with `statcalib' retained only as a separately labeled extension-lane supplement. Latency, resource, and cost advantages are architecture-level consequences of the affine fast path and should be measured on hardware before being written as deployment results}{table.caption.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Four-scenario affine benchmark. Entries are \(\texttt  {final\_ler\_mean}\); lower is better.}}{23}{table.caption.14}\protected@file@percent }
