\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Descriptive UKF-minus-hybrid margins in the frozen benchmark. \(\Delta \) is UKF \(\texttt  {final\_ler}\) minus Hybrid-\(b\) \(\texttt  {final\_ler}\). Positive values indicate lower hybrid error. The rows summarize the available paired source data only; they are not inferential statistics or expanded-benchmark evidence.}}{23}{table.caption.15}\protected@file@percent }
\newlabel{tab:paired-margin-note}{{3}{23}{Descriptive UKF-minus-hybrid margins in the frozen benchmark. \(\Delta \) is UKF \(\texttt {final\_ler}\) minus Hybrid-\(b\) \(\texttt {final\_ler}\). Positive values indicate lower hybrid error. The rows summarize the available paired source data only; they are not inferential statistics or expanded-benchmark evidence}{table.caption.15}{}}
