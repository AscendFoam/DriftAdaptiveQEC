\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Controlled known-state holdout drift stress diagnostic. Entries are residual MSE across 384 sequences of 512 steps; lower is better. The lagged row is a known-state slow-commit reference, not the trained residual branch. The table is a non-hardware stress test, not holdout robustness proof.}}{24}{table.caption.21}\protected@file@percent }
\newlabel{tab:holdout-stress-note}{{9}{24}{Controlled known-state holdout drift stress diagnostic. Entries are residual MSE across 384 sequences of 512 steps; lower is better. The lagged row is a known-state slow-commit reference, not the trained residual branch. The table is a non-hardware stress test, not holdout robustness proof}{table.caption.21}{}}
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces Controlled one-step local-Gaussian residual-MSE diagnostic. Lower is better. The omitted direct nearest-syndrome row is substantially weaker in the same source table because it applies the noisy wrapped syndrome as a hard correction. This is a sanity check for estimator and decoder limits, not a formal software-HIL or hardware benchmark.}}{24}{table.caption.22}\protected@file@percent }
\newlabel{tab:controlled-baselines-note}{{10}{24}{Controlled one-step local-Gaussian residual-MSE diagnostic. Lower is better. The omitted direct nearest-syndrome row is substantially weaker in the same source table because it applies the noisy wrapped syndrome as a hard correction. This is a sanity check for estimator and decoder limits, not a formal software-HIL or hardware benchmark}{table.caption.22}{}}
\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces Compressed cost and fixed-point diagnostics for the affine fast path. The arithmetic rows are analytical per-shot counts. The fixed-point row is software emulation only. The table supports the bounded datapath rationale, not measured FPGA timing, resources, power, or source-vs-board agreement.}}{25}{table.caption.23}\protected@file@percent }
\newlabel{tab:cost-fixedpoint-note}{{11}{25}{Compressed cost and fixed-point diagnostics for the affine fast path. The arithmetic rows are analytical per-shot counts. The fixed-point row is software emulation only. The table supports the bounded datapath rationale, not measured FPGA timing, resources, power, or source-vs-board agreement}{table.caption.23}{}}
