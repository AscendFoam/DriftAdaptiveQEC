\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Local sensitivity within the bounded statistical-calibration extension lane. Mean rank is computed within the five variants for each scenario; the near-tie between default and high-threshold prevents a unique promoted setting.}}{24}{table.caption.19}\protected@file@percent }
