\newlabel{tab:phase-a-interval-note}{{4}{23}{Formal Phase A scenario-level UKF-minus-hybrid interval checks. The rows summarize the completed formal-length paired repeats for two scenarios only; they do not complete the all-scenario gate}{table.caption.16}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Feature and teacher ablation summary. Negative \(\Delta \) means improvement over the reference.}}{23}{table.caption.17}\protected@file@percent }
