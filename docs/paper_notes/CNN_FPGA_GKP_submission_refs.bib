	note = {arXiv:2311.01328 [quant-ph]},
	keywords = {Quantum Physics, Computer Science - Information Theory},
	pages = {020349},
	annote = {Comment: 30 pages, 15 figures},
	file = {Preprint PDF:C\:\\Users\\26410\\Zotero\\storage\\DC9GIGZW\\Berent 等 - 2024 - Analog information decoding of bosonic quantum LDPC codes.pdf:application/pdf;Snapshot:C\:\\Users\\26410\\Zotero\\storage\\UTRJU662\\2311.html:text/html},
}

