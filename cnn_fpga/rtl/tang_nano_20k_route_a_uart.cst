// Candidate Tang Nano 20K v1.3 pinout.  clk/reset/UART are copied from the
// Sipeed official UART example.  Strobes use the documented LCD connector
// range already used by this repository's synthesis harness.  Physical board
// revision and signal integrity remain unverified until T6.1.1/T6.1.3.
IO_LOC "clk" 4;
IO_PORT "clk" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "reset_n" 88;
IO_PORT "reset_n" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "uart_rx" 70;
IO_PORT "uart_rx" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "uart_tx" 69;
IO_PORT "uart_tx" DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC "action_strobe" 25;
IO_PORT "action_strobe" DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC "error_strobe" 26;
IO_PORT "error_strobe" DRIVE=8 IO_TYPE=LVCMOS33;
