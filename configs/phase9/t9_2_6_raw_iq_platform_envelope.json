  "cdc_backpressure_reset_contract": {
    "source_assumption": "RFDC/replay ingress can be nonstallable",
    "elastic_buffer": {
      "minimum_complete_windows": 2,
      "minimum_beats": 256,
      "storage_mode": "packet-aware asynchronous FIFO or equivalent",
      "gray_pointer_or_vendor_proven_cdc_required": true
    },
    "backpressure": "downstream may deassert TREADY; accepted payload must not change",
    "overflow": "abort and poison the entire affected window; silent sample drop forbidden",
    "reset_assertion": "asynchronous assertion permitted at CDC primitive, all externally observed state fails closed",
    "reset_deassertion": "synchronous in each clock domain; no transfer until both sides have exited reset",
    "minimum_reset_cycles_slowest_clock": 16,
    "window_reset": "reset before retired TLAST poisons the complete window",
    "window_deadline_axis_cycles": 192,
    "timeout_retirement": "at deadline emit exactly one poisoned observation_valid=0 record, quarantine until the affected TLAST/flush boundary, and never execute its candidate action",
    "fifo_flush": "reset epoch increments exactly one only after both domains acknowledge flush; stale pre-reset beats with an older epoch are rejected",
    "cross_window_freshness": "stateful last-retired window_id/final_timestamp/config_version/reset_epoch receipt; same-epoch window_id must increment exactly one, timestamps increase, config holds or advances one; epoch change restarts window_id=0 and forbids epoch wrap",
    "error_priority": [
      "AXIS_STABILITY_FAILURE",
      "WINDOW_TIMEOUT_FAILURE",
      "QUARANTINE_ACTIVE_FAILURE",
      "RESET_MID_WINDOW",
      "CDC_OVERFLOW",
      "SOURCE_OR_RFDC_FAILURE",
      "PACKAGE_INTEGRITY_FAILURE",
      "CONFIG_VERSION_FAILURE",
      "INVALID_METADATA",
      "FRESHNESS_REPLAY_FAILURE",
      "TIMESTAMP_FAILURE",
      "SAMPLE_SEQUENCE_FAILURE",
      "WINDOW_FRAMING_FAILURE",
      "INPUT_QUALITY_FAILURE",
      "ACCEPT"
    ],
    "axis_protocol_precondition": "TVALID and payload stability is checked before a transferred window can enter the error-priority parser",
    "no_postselection": true
  },
