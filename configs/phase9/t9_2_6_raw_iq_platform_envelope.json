  "arithmetic_contract": {
    "matched_filter_equation": "y=sum_n(conj(h[n])*x[n])",
    "coefficient_energy": "sum_n(h_i[n]^2+h_q[n]^2) of the quantized Q1.17 codes must be within 2^-12 of one after quantization",
    "rounding_on_every_narrowing": "round-to-nearest ties-to-even",
    "overflow": "signed saturation plus sticky overflow; wraparound forbidden",
    "sticky_overflow_effect": "poison whole window and emit observation_valid=0",
    "complex_multiply": {
      "real": "i*h_i + q*h_q",
      "imag": "q*h_i - i*h_q"
    },
    "matched_filter_accumulator_proof": {
      "maximum_legal_abs_code_upper_bound": 1099511627776,
      "signed_48_positive_limit": 140737488355327,
      "minimum_headroom_ratio": 127.99999999999909,
      "legal_input_overflow_expected": false,
      "sticky_overflow_still_required_for_fault_injection": true
    },
    "calibration": "2x2 affine transform plus offset, package-versioned",
    "calibration_bit_path": {
      "accumulator_times_matrix": "48-bit Q16.32 x 18-bit Q2.16 -> 66-bit Q18.48",
      "two_products_plus_offset": "two 66-bit products + sign-extended (Q8.16 << 32) offset -> 67-bit Q19.48",
      "narrowing": "arithmetic right shift 32 with ties-to-even, then signed saturation to 24-bit Q8.16",
      "overflow": "narrowing saturation raises sticky overflow and poisons the complete window"
    },
    "discriminator": "four structural threshold/hysteresis registers in signed Q8.16",
    "threshold_values": null,
    "threshold_status": "BLOCKED_UNQUALIFIED_T9_2_4_NO_GO",
    "threshold_selection_released_by": "fresh T-RISK-20260726-01 dual-backend qualification PASS only"
  },
